
# --- Извлечение данных (Extract) ---
API_BASE_URL=https://api.example.com/v1  # Базовый URL внешнего API
API_ENDPOINT=/orders                     # Эндпоинт API
API_TOKEN=your_super_secret_token_here   # Токен авторизации (ЗАМЕНИТЬ НА РЕАЛЬНЫЙ)

# --- Трансформация (Transform) ---
SOURCE_DB_URL=postgresql://user:password@localhost:5432/source_db  # Строка подключения к PostgreSQL
TARGET_DB_URL=postgresql://user:password@localhost:5432/target_db  # Строка подключения к целевой БД (если используется)

# --- Загрузка (Load) ---
CLICKHOUSE_HOST=localhost                # Хост ClickHouse
CLICKHOUSE_PORT=9000                     # Порт ClickHouse (9000 - нативный, 8123 - HTTP)
CLICKHOUSE_USER=default                  # Пользователь ClickHouse
CLICKHOUSE_PASSWORD=                     # Пароль ClickHouse (оставить пустым для локалки)
CLICKHOUSE_DATABASE=ecommerce            # Имя базы данных в ClickHouse
CLICKHOUSE_TABLE=orders                  # Имя целевой таблицы

# --- Общие настройки ---
BATCH_SIZE=10000                         # Размер батча для обработки (оптимально для RAM)
REQUEST_TIMEOUT=30                       # Таймаут HTTP запросов в секундах
MAX_RETRIES=3                            # Максимум попыток при ошибке сети