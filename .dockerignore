# --- Git и IDE ---
.git/                       # Папка Git (не нужна в образе)
.idea/                      # Настройки PyCharm
.vscode/                    # Настройки VS Code

# --- Виртуальное окружение и кэш ---
venv/                       # Локальное виртуальное окружение (мы ставим зависимости внутри контейнера заново)
__pycache__/                # Скомпилированный Python мусор
*.pyc                       # Скомпилированные файлы
.pytest_cache/              # Кэш тестов

# --- Данные и Логи ---
logs/                       # Логи (генерируются при работе, не нужны при сборке)
data/                       # Тяжелые локальные данные
.env                        # Файл с секретами (никогда не попадать в образ!)

# --- Документация ---
docs/                       # Документация не нужна в продакшн-образе
README.md                   # Ридми не нужен внутри контейнера