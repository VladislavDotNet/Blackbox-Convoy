
# --- БЛОК 1: БАЗОВЫЙ ОБРАЗ И ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ---
FROM python:3.10-slim  # Берем официальный легкий образ Python 3.10 на базе Debian Slim (без лишнего мусора)

# Устанавливаем переменные окружения для Python внутри контейнера
ENV PYTHONUNBUFFERED=1  # Отключаем буферизацию вывода (логи в Docker будут появляться мгновенно, а не копиться)
ENV PYTHONDONTWRITEBYTECODE=1  # Запрещаем Python создавать файлы .pyc (они не нужны в контейнере и засоряют образ)

# --- БЛОК 2: СИСТЕМНЫЕ ЗАВИСИМОСТИ ---
# Назначение: Установка библиотек ОС, необходимых для компиляции Python-пакетов (например, psycopg2).
RUN apt-get update && \  # Обновляем списки пакетов Debian
    apt-get install -y --no-install-recommends gcc libpq-dev && \  # Устанавливаем gcc (компилятор) и заголовки PostgreSQL (нужны для psycopg2-binary/sqlalchemy)
    rm -rf /var/lib/apt/lists/*  # Очищаем кэш apt, чтобы уменьшить итоговый размер образа (best practice)

# --- БЛОК 3: РАБОЧАЯ ДИРЕКТОРИЯ ---
WORKDIR /app  # Создаем и переходим в папку /app внутри контейнера (стандартное место для кода)

# --- БЛОК 4: УСТАНОВКА PYTHON ЗАВИСИМОСТЕЙ (С КЭШИРОВАНИЕМ) ---
# Назначение: Копируем только requirements сначала, чтобы Docker закэшировал этот слой.
# Если код изменится, но requirements нет, Docker не будет переустанавливать библиотеки.
COPY requirements.txt requirements-dev.txt ./  # Копируем файлы зависимостей из хоста в текущую папку контейнера (/app)

RUN pip install --no-cache-dir --upgrade pip && \  # Обновляем pip и отключаем кэш установки (уменьшает размер образа)
    pip install --no-cache-dir -r requirements.txt && \  # Устанавливаем основные зависимости
    pip install --no-cache-dir -r requirements-dev.txt  # Устанавливаем dev-зависимости (для тестов и линтеров)

# --- БЛОК 5: КОПИРОВАНИЕ ИСХОДНОГО КОДА ---
COPY . .  # Копируем весь проект из корня хоста в /app внутри контейнера

# --- БЛОК 6: ТОЧКА ВХОДА (ОПЦИОНАЛЬНО) ---
# Назначение: Команда, которая выполнится при запуске контейнера (docker run).
# Обычно в ETL это запуск Airflow или конкретного скрипта. Здесь оставим bash для гибкости.
CMD ["bash"]  # При запуске контейнера без команд откроется bash-сессия